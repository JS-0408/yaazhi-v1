{
  "name": "Yaazhi — WhatsApp Notify",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "yaazhi-notify",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "n8n-webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "yaazhi-notify-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.priority }}",
              "operation": "equals",
              "value2": "high"
            }
          ]
        }
      },
      "id": "n8n-switch-priority",
      "name": "Priority Switch",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [460, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "to": "={{ $vars.WHATSAPP_RECIPIENT }}",
        "message": "={{ '🔴 [HIGH PRIORITY] ' + $json.body.task_name + '\\n\\n' + $json.body.message + '\\n\\n⏰ ' + $json.body.timestamp }}"
      },
      "id": "n8n-whatsapp-high",
      "name": "WhatsApp High Priority",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [680, 200],
      "credentials": {
        "whatsAppApi": {
          "id": "whatsapp-credentials",
          "name": "WhatsApp API"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "to": "={{ $vars.WHATSAPP_RECIPIENT }}",
        "message": "={{ '✅ Yaazhi: ' + $json.body.task_name + '\\n' + $json.body.message + '\\n\\n⏰ ' + $json.body.timestamp }}"
      },
      "id": "n8n-whatsapp-normal",
      "name": "WhatsApp Normal Priority",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [680, 400],
      "credentials": {
        "whatsAppApi": {
          "id": "whatsapp-credentials",
          "name": "WhatsApp API"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": "={{ $vars.GOOGLE_SHEET_ID }}",
        "sheetName": "notifications",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "timestamp": "={{ $json.body.timestamp }}",
            "channel": "whatsapp",
            "priority": "={{ $json.body.priority }}",
            "task_name": "={{ $json.body.task_name }}",
            "message": "={{ $json.body.message }}",
            "delivered": true
          }
        }
      },
      "id": "n8n-sheets-log",
      "name": "Log to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [900, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "google-sheets-credentials",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, delivered_at: new Date().toISOString(), channel: 'whatsapp', priority: $json.body.priority }) }}"
      },
      "id": "n8n-webhook-response",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Priority Switch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Priority Switch": {
      "main": [
        [
          {
            "node": "WhatsApp High Priority",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "WhatsApp Normal Priority",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "WhatsApp High Priority": {
      "main": [
        [
          {
            "node": "Log to Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "WhatsApp Normal Priority": {
      "main": [
        [
          {
            "node": "Log to Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log to Google Sheets": {
      "main": [
        [
          {
            "node": "Webhook Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1.0.0",
  "meta": {
    "instanceId": "yaazhi-n8n-instance",
    "templateCredsSetupCompleted": false
  },
  "id": "yaazhi-whatsapp-notify",
  "tags": ["yaazhi", "notifications", "whatsapp"]
}
