# ═══════════════════════════════════════════════════════════════
# YAAZHI ENVIRONMENT CONFIGURATION
# Copy this file to config/.env and fill in your actual values.
# NEVER commit the real .env to git — it is in .gitignore.
# Owner: Santhosh · VIT-AP · ECE · 2026
# Version: V4 (Phase 1 — pgvector primary backend)
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# SECTION 1 — CORE MODELS
# ───────────────────────────────────────────────────────────────

# Groq — ultra-fast inference (REQUIRED — free, no card needed)
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# Google AI — Gemini for long context (OPTIONAL — free tier)
# Get at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AIza_your_google_api_key_here

# Ollama — local models running on your machine (OPTIONAL — no key)
# Default: runs on localhost; change if running on separate host
OLLAMA_BASE_URL=http://localhost:11434

# Azure OpenAI — GPT-4o (OPTIONAL — requires Azure student credit)
# Only set these if you have Azure student access
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Anthropic — Claude (OPTIONAL — requires card)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# ───────────────────────────────────────────────────────────────
# SECTION 2 — MEMORY & DATABASES
# ───────────────────────────────────────────────────────────────

# PRIMARY BACKEND SELECTOR — one of: pgvector | chromadb | mem0
# pgvector is the default and the only fully-tested primary path.
# Change this only if you are intentionally switching backends.
VECTOR_BACKEND=pgvector

# ── REQUIRED ─────────────────────────────────────────────────

# PostgreSQL + pgvector — PRIMARY vector store (REQUIRED)
# Free options (no card needed):
#   Supabase:  https://app.supabase.com → Settings → Database → URI
#   Neon:      https://neon.tech → Dashboard → Connection Details
# Format: postgresql://user:password@host:port/database
POSTGRES_URL=postgresql://yaazhi:yaazhi_password@localhost:5432/yaazhi_db

# Redis — embedding cache in front of pgvector (REQUIRED)
# Free option (no card needed): https://upstash.com → Create Database → REST URL
# Paste the rediss:// URL (with TLS) that Upstash gives you
REDIS_URL=redis://localhost:6379/0

# ── OPTIONAL / EXPERIMENTAL ──────────────────────────────────
# The following are only used when VECTOR_BACKEND is set to
# their respective value. Leave defaults if using pgvector.

# ChromaDB — only used when VECTOR_BACKEND=chromadb
CHROMADB_HOST=localhost
CHROMADB_PORT=8001

# Mem0 — only used when VECTOR_BACKEND=mem0
# Get at: https://app.mem0.ai
MEM0_API_KEY=your_mem0_api_key_here

# Supabase convenience shortcuts (postgres_url still required above)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ───────────────────────────────────────────────────────────────
# SECTION 3 — VOICE & LANGUAGE
# ───────────────────────────────────────────────────────────────

# Bhashini — Indian government AI for Telugu/Hindi/Tamil voice (OPTIONAL)
# Register at: https://bhashini.gov.in → Developer → API Access
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_PIPELINE_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline

# Whisper — STT model size: tiny|base|small|medium|large (OPTIONAL)
WHISPER_MODEL_SIZE=base

# OpenWakeWord — detection sensitivity 0.0–1.0 (OPTIONAL)
WAKEWORD_SENSITIVITY=0.7

# Telegram Bot — notifications (OPTIONAL — free, no card)
# Get at: https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ───────────────────────────────────────────────────────────────
# SECTION 4 — ACTIONS & INTEGRATIONS
# ───────────────────────────────────────────────────────────────

# Firecrawl — advanced web scraping (OPTIONAL — free tier)
# Get at: https://firecrawl.dev
FIRECRAWL_API_KEY=fc-your_firecrawl_key_here

# n8n — webhook base URL for notification workflows (OPTIONAL)
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
N8N_BASIC_AUTH_USER=yaazhi_admin
N8N_BASIC_AUTH_PASSWORD=change_this_strong_password

# MQTT — for future IoT/ESP32 integration (OPTIONAL)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=yaazhi
MQTT_PASSWORD=your_mqtt_password_here

# ───────────────────────────────────────────────────────────────
# SECTION 5 — OPS & MONITORING
# ───────────────────────────────────────────────────────────────

# LangSmith — trace LangGraph reasoning (OPTIONAL — free tier)
# Get at: https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__your_langsmith_key_here
LANGCHAIN_PROJECT=yaazhi-production

# Logfire — AI action audit logging (OPTIONAL — free tier)
# Get at: https://logfire.pydantic.dev
LOGFIRE_TOKEN=your_logfire_token_here

# Cloudflare Zero Trust tunnel (OPTIONAL — free)
# Get at: https://one.dash.cloudflare.com → Networks → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Grafana admin credentials (OPTIONAL — only if running Grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password

# ───────────────────────────────────────────────────────────────
# SECTION 6 — APPLICATION SETTINGS
# ───────────────────────────────────────────────────────────────

APP_NAME=Yaazhi
APP_VERSION=4.0.0
OWNER_NAME=Santhosh
OWNER_EMAIL=js.santhosh.0408@gmail.com

# API security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
YAAZHI_API_KEY=generate_a_strong_random_key_here

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
ENV=development

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501,https://yaazhi.yourdomain.com

# LangGraph loop control
MAX_LOOP_COUNT=5

# Default user namespace for memory isolation
DEFAULT_USER_ID=default

# Backup encryption passphrase
# Generate with: openssl rand -base64 32
BACKUP_PASSPHRASE=generate_a_strong_backup_passphrase_here

# Directories
KNOWLEDGE_BASE_DIR=knowledge
LOG_DIR=logs
