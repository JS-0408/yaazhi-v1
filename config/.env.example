# ═══════════════════════════════════════════════════════════════
# YAAZHI ENVIRONMENT CONFIGURATION
# Copy this file to config/.env and fill in your actual values.
# NEVER commit the real .env to git — it is in .gitignore.
# Owner: Santhosh · VIT-AP · ECE · 2026
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# SECTION 1 — CORE MODELS
# ───────────────────────────────────────────────────────────────

# Groq — ultra-fast inference for research + quick tasks
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# Azure OpenAI — GPT-4o for final review (student $100 credit)
# Get at: https://aka.ms/azure4students → create OpenAI resource
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Google AI — Gemini 1.5 Pro for PDFs and long context
# Get at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AIza_your_google_api_key_here

# Anthropic — Claude claude-sonnet-4-6 for code generation
# Get at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# Ollama — local models running on your VPS (no API key needed)
# Default: runs on localhost; change if running on separate host
OLLAMA_BASE_URL=http://localhost:11434

# ───────────────────────────────────────────────────────────────
# SECTION 2 — MEMORY & DATABASES
# ───────────────────────────────────────────────────────────────

# ChromaDB — vector database (primary memory store)
CHROMADB_HOST=localhost
CHROMADB_PORT=8001

# PostgreSQL + pgvector — fallback semantic memory + structured data
# Format: postgresql://user:password@host:port/database
POSTGRES_URL=postgresql://yaazhi:yaazhi_password@localhost:5432/yaazhi_db

# Redis — short-term cache and rate limiting
# Format: redis://[:password@]host:port/db_number
REDIS_URL=redis://localhost:6379/0

# Mem0 — dedicated AI memory layer for episodic memory
# Get at: https://app.mem0.ai
MEM0_API_KEY=your_mem0_api_key_here

# Supabase — PostgreSQL + vector + auth + realtime (optional backup)
# Get at: https://app.supabase.com → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ───────────────────────────────────────────────────────────────
# SECTION 3 — VOICE & LANGUAGE
# ───────────────────────────────────────────────────────────────

# Bhashini — Indian government AI for Telugu/Hindi/Tamil voice
# Register at: https://bhashini.gov.in → Developer → API Access
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_PIPELINE_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline

# Whisper — speech-to-text model size (tiny/base/small/medium/large)
# base is best balance of speed and accuracy for VPS with 4GB RAM
WHISPER_MODEL_SIZE=base

# OpenWakeWord — detection sensitivity (0.0 = never trigger, 1.0 = very sensitive)
WAKEWORD_SENSITIVITY=0.7

# Telegram Bot — for direct Telegram notifications (no WhatsApp needed)
# Get at: https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ───────────────────────────────────────────────────────────────
# SECTION 4 — ACTIONS & INTEGRATIONS
# ───────────────────────────────────────────────────────────────

# Firecrawl — advanced web scraping for JavaScript-heavy sites
# Get at: https://firecrawl.dev (free tier available)
FIRECRAWL_API_KEY=fc-your_firecrawl_key_here

# n8n — webhook base URL for notification workflows
# This is your n8n instance URL (running in Docker on your VPS)
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
N8N_BASIC_AUTH_USER=yaazhi_admin
N8N_BASIC_AUTH_PASSWORD=change_this_strong_password

# MQTT — for future IoT/ESP32 integration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=yaazhi
MQTT_PASSWORD=your_mqtt_password_here

# ───────────────────────────────────────────────────────────────
# SECTION 5 — OPS & MONITORING
# ───────────────────────────────────────────────────────────────

# LangSmith — trace and debug LangGraph agent reasoning
# Get at: https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__your_langsmith_key_here
LANGCHAIN_PROJECT=yaazhi-production

# Logfire — professional AI action audit logging (Pydantic product)
# Get at: https://logfire.pydantic.dev
LOGFIRE_TOKEN=your_logfire_token_here

# Cloudflare Zero Trust tunnel — secure access without open ports
# Get at: https://one.dash.cloudflare.com → Networks → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password

# ───────────────────────────────────────────────────────────────
# SECTION 6 — APPLICATION SETTINGS
# ───────────────────────────────────────────────────────────────

# App identity
APP_NAME=Yaazhi
APP_VERSION=1.0.0
OWNER_NAME=Santhosh
OWNER_EMAIL=js.santhosh.0408@gmail.com

# API security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
YAAZHI_API_KEY=generate_a_strong_random_key_here

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501,https://yaazhi.yourdomain.com

# LangGraph loop control — max reasoning iterations before forcing answer
MAX_LOOP_COUNT=5

# Backup encryption passphrase — for config/.env backup
# Generate with: openssl rand -base64 32
BACKUP_PASSPHRASE=generate_a_strong_backup_passphrase_here

# Knowledge base root directory
KNOWLEDGE_BASE_DIR=knowledge

# Logs directory
LOG_DIR=logs
